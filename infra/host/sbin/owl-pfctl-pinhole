#!/bin/sh
# owl-pfctl-pinhole — pfctl ピンホールテーブル操作の検証済みラッパー
# doas から "permit nopass owl-control cmd /usr/local/sbin/owl-pfctl-pinhole" で呼び出す
# IP アドレスの検証をここで行い、pfctl に任意の引数を渡せないようにする
set -eu

PINHOLE_TABLE="pinhole_dst"

_usage() {
    echo "usage: owl-pfctl-pinhole open <ip> [<ip> ...]" >&2
    echo "       owl-pfctl-pinhole close" >&2
    exit 1
}

# IPv4 アドレスの形式検証 (0.0.0.0–255.255.255.255)
_valid_ip() {
    echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
    IFS=. read -r a b c d <<EOF
$1
EOF
    for octet in "$a" "$b" "$c" "$d"; do
        [ "$octet" -le 255 ] 2>/dev/null || return 1
    done
}

case "${1:-}" in
    open)
        shift
        [ "$#" -ge 1 ] || _usage

        tmpfile="$(mktemp /tmp/owl-pinhole.XXXXXX)"
        trap 'rm -f "$tmpfile"' EXIT

        for ip in "$@"; do
            _valid_ip "$ip" || { echo "不正な IP アドレス: ${ip}" >&2; exit 1; }
            echo "$ip" >> "$tmpfile"
        done

        pfctl -t "$PINHOLE_TABLE" -T replace -f "$tmpfile"
        echo "ピンホール開放: $(tr '\n' ' ' < "$tmpfile")"
        ;;

    close)
        pfctl -t "$PINHOLE_TABLE" -T flush
        echo "ピンホール閉鎖"
        ;;

    *)
        _usage
        ;;
esac
