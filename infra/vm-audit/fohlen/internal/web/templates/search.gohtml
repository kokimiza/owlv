{{define "search_page"}}
<!DOCTYPE html>
<html lang="ja">
<head>{{template "head" .}}</head>
<body>
{{template "nav" .}}
<h1>検索</h1>
<form id="search-form" hx-get="/partials/search" hx-target="#search-results" hx-trigger="submit, change">
  <label>キーワード (FTS5): <input type="text" name="q" value="{{.RawFilter.Keyword}}"></label>
  <label>送信元ホスト:
    <select name="source_host">
      <option value="">(any)</option>
      {{range .SourceHosts}}<option value="{{.}}" {{if eq . $.RawFilter.SourceHost}}selected{{end}}>{{.}}</option>{{end}}
    </select>
  </label>
  <label>カテゴリ:
    <select name="category">
      <option value="">(any)</option>
      {{range .Categories}}<option value="{{.}}" {{if eq . $.RawFilter.Category}}selected{{end}}>{{.}}</option>{{end}}
    </select>
  </label>
  <label>開始: <input type="datetime-local" name="from" value="{{.RawFilter.From}}"></label>
  <label>終了: <input type="datetime-local" name="to" value="{{.RawFilter.To}}"></label>
  <input type="hidden" name="page" value="0">
  <button type="submit">検索</button>
</form>
<div id="search-results" hx-get="/partials/search" hx-trigger="load" hx-include="#search-form">
  検索条件を指定してください。
</div>
</body>
</html>
{{end}}

{{define "search_results_partial"}}
<table>
  <tr><th>時刻</th><th>ホスト</th><th>カテゴリ</th><th>Actor</th><th>本文</th></tr>
  {{range .Results}}
  <tr>
    <td>{{.Timestamp.Format "2006-01-02 15:04:05"}}</td>
    <td>{{.SourceHost}}</td>
    <td class="cat-{{.Category}}">{{.Category}}</td>
    <td>{{.Actor}}</td>
    <td>{{.Message}}</td>
  </tr>
  {{else}}
  <tr><td colspan="5">該当する結果がありません。</td></tr>
  {{end}}
</table>
<div class="pagination">
  {{if .HasPrev}}
  <button hx-get="/partials/search" hx-target="#search-results" hx-include="#search-form"
          hx-vals='{"page": {{printf "%d" (sub .Page 1)}}}'>« 前へ</button>
  {{end}}
  <span>ページ {{printf "%d" (add1 .Page)}}</span>
  {{if .HasNext}}
  <button hx-get="/partials/search" hx-target="#search-results" hx-include="#search-form"
          hx-vals='{"page": {{printf "%d" (add1 .Page)}}}'>次へ »</button>
  {{end}}
</div>
{{end}}
