cabal-version:      3.0
name:               owlv
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             kokimiza
maintainer:         tokunaga@jocarium.productions
category:           System
build-type:         Simple
extra-doc-files:    CHANGELOG.md
tested-with:        GHC ==9.14.1

common warnings
    ghc-options: -Wall
    default-extensions: OverloadedStrings

common core-deps
    build-depends:
        base       >= 4.20,
        text       >= 2.0,
        time       >= 1.12,
        uuid       >= 1.3,
        containers >= 0.6,
        Decimal    >= 0.5,
        aeson      >= 2.0

library
    import:           warnings, core-deps
    hs-source-dirs:   src
    exposed-modules:
        Core.Domain.Money
        Core.Domain.AccountCode
        Core.Domain.Journal
        Core.Domain.Organisation
        Core.Domain.OrgPermission
        Core.Domain.Partner
        Core.Domain.AccountMaster
        Core.Domain.SubAccount
        Core.Domain.CashTransaction
        Core.Domain.Reconciliation
        Core.Domain.AccountingPeriod
        Core.Domain.FixedAsset
        Core.Domain.Ecl
        Core.Domain.FxRate
        Core.Domain.JudgmentLog
        Core.Domain.Materiality
        Core.Domain.EmployeeBenefit
        Core.Domain.Tax
        Core.Domain.Tenant
        Core.Domain.User
        Core.Domain.Project
        Core.Domain.ExternalOrder
        Core.Domain.Personnel
        Core.Domain.WorkAssignment
        Core.Domain.ManagementAccounting
        Core.Error
        Core.Command
        Core.Event
        Core.State
        Core.Decide
        Core.Evolve
        Shell.AppError
        Shell.ErrorCatalog
        Shell.EventStore
        Shell.EventClassification
        Shell.ReadModel
        Shell.Projector
        Shell.Effects
        Shell.Interpreters.EventStore
        Shell.Interpreters.Clock
        Shell.Interpreters.UserContext
        Shell.Interpreters.AuditLog
        Shell.Interpreters.PasswordHash
        Shell.Interpreters.UserOsSync
        Shell.Interpreters.OsIdentity
        Shell.CommandExecutor
        Shell.UserOps
        Shell.TUI.Attrs
        Shell.TUI.Helpers
        Shell.TUI.Types
        Shell.TUI.Submit
        Shell.TUI.App
        Shell.TUI.Screen.Menu
        Shell.TUI.Screen.Journal
        Shell.TUI.Screen.Master.Menu
        Shell.TUI.Screen.Master.Organisation
        Shell.TUI.Screen.Master.Partner
        Shell.TUI.Screen.Master.AccountCode
        Shell.TUI.Screen.Master.SubAccount
        Shell.TUI.Screen.Master.User
        Shell.TUI.Screen.VoucherSearch
    build-depends:
        brick                >= 2.3,
        vty                  >= 6.2,
        vty-crossplatform    >= 0.4,
        effectful            >= 2.3,
        postgresql-simple >= 0.7,
        bytestring        >= 0.11,
        process           >= 1.6,
        -- ExceptT + throwError/liftEither/withExceptT による早期リターン記述用
        -- (CommandExecutor / UserOps / UserOsSync の IO+Either ネスト解消)。
        -- GHC boot package なので追加インストール不要。
        mtl               >= 2.3,
        -- パスワードハッシュ (Argon2id, §2.3): crypton は libargon2 を同梱ビルドするため
        -- 外部Cライブラリの事前インストールは不要 (doc/user.md §2.3)。
        -- argon2 パッケージ(hvr/argon2)は base<4.18 に固定され GHC2024(base>=4.20)と
        -- 不整合のため、メンテナンスされている crypton 経由で同じ実装を使う。
        crypton           >= 1.0,
        memory            >= 0.18,
        base64-bytestring >= 1.2,
        -- SSH 確立した OS ログイン名の取得 (doc/user.md §4.1)。GHC boot package。
        unix              >= 2.8,
        -- リードモデル (doc/cqrs.md): SQLite3 を bundled amalgamation で
        -- 静的にコンパイルする (systemlib フラグ既定 False)。OpenBSD側に
        -- libsqlite3 の動的リンク依存を作らない。json1 フラグ(既定 True)で
        -- §5.2 の GENERATED ALWAYS AS ... json_extract が使えることを前提にする。
        direct-sqlite     >= 2.3,
        filepath          >= 1.4,
        directory         >= 1.3
    default-language: GHC2024

executable owlv
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20,
        text >= 2.0,
        mtl  >= 2.3,
        owlv
    default-language: GHC2024

executable owlv-batch-center
    import:           warnings, core-deps
    main-is:          Main.hs
    hs-source-dirs:   batch
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    other-modules:
        Batch.Env
        Batch.DailyClose
        Batch.WalShip
        Batch.VacuumCheck
    build-depends:
        owlv,
        effectful            >= 2.3,
        optparse-applicative >= 0.18
    default-language: GHC2024

executable owlv-projector
    import:           warnings, core-deps
    main-is:          Main.hs
    hs-source-dirs:   projector
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        owlv,
        postgresql-simple    >= 0.7,
        optparse-applicative >= 0.18,
        directory            >= 1.3
    default-language: GHC2024

test-suite owlv-test
    import:           warnings, core-deps
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    other-modules:
        Core.JournalSpec
        Core.MasterSpec
        Core.SettlementSpec
        Core.FixedAssetSpec
        Core.EclSpec
        Core.MaterialitySpec
        Core.FxRateSpec
        Core.JudgmentLogSpec
        Core.ClosingSpec
        Core.UserSpec
        Core.TenantSpec
        Core.ProjectSpec
        Core.LaborSpec
        Core.ManagementAccountingSpec
    build-depends:
        owlv,
        tasty            >= 1.4,
        tasty-quickcheck >= 0.10,
        tasty-hunit      >= 0.10,
        QuickCheck       >= 2.14
    default-language: GHC2024

