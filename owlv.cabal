cabal-version:      3.0
name:               owlv
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             kokimiza
maintainer:         tokunaga@jocarium.productions
category:           System
build-type:         Simple
extra-doc-files:    CHANGELOG.md
tested-with:        GHC ==9.14.1

common warnings
    ghc-options: -Wall
    default-extensions: OverloadedStrings

common core-deps
    build-depends:
        base       >= 4.20,
        text       >= 2.0,
        time       >= 1.12,
        uuid       >= 1.3,
        containers >= 0.6,
        Decimal    >= 0.5

library
    import:           warnings, core-deps
    hs-source-dirs:   src
    exposed-modules:
        Core.Domain.Money
        Core.Domain.AccountCode
        Core.Domain.Journal
        Core.Error
        Core.Command
        Core.Event
        Core.State
        Core.Decide
        Core.Evolve
        Shell.AppError
        Shell.EventStore
        Shell.CommandExecutor
        Shell.TUI.Types
        Shell.TUI.Submit
        Shell.TUI.App
    build-depends:
        brick        >= 2.3,
        vty          >= 6.2,
        effectful    >= 2.3
    default-language: GHC2024

executable owlv
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20,
        owlv
    default-language: GHC2024

test-suite owlv-test
    import:           warnings, core-deps
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    other-modules:
        Core.JournalSpec
    build-depends:
        owlv,
        tasty            >= 1.4,
        tasty-quickcheck >= 0.10,
        tasty-hunit      >= 0.10,
        QuickCheck       >= 2.14
    default-language: GHC2024
